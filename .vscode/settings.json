{
  "dart.lineLength": 120,
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "Dart-Code.dart-code",
    "editor.rulers": [120],
    "editor.tabSize": 2,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "dart.previewFlutterUiGuides": true,
  "dart.closingLabels": true,
  "dart.showTodos": true
}
